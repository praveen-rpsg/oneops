# build output
/bin/
coverage.out
coverage.html

# The knowledge graph is generated, never committed (ADR-PKG-001). It is
# derived from the whole tree, so every change regenerates it and every
# concurrent pull request would conflict on it. `make graph` rewrites it.
/pkg.json

# database dumps — never commit data
/backups/
*.dump

# env & secrets
.env
*.local

# node
node_modules/
web/**/dist/
*.tsbuildinfo

# The console bundle is a build artifact produced by `make web`. The directory
# itself is tracked (via .gitkeep) because //go:embed all:webdist must resolve
# for the Go build to compile at all.
internal/httpapi/webdist/*
!internal/httpapi/webdist/.gitkeep

# terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# os
.DS_Store
